{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recordweb.github.io/poc-fragestunde/schemas/bar-conformance-record-poc.json",
  "title": "BAR ConformanceRecord Payload – Fragestunde PoC Stage 1",
  "description": "PoC-Erweiterung des RWP-ConformanceRecord-Payloads mit Assessment-Ergebnissen.",
  "type": "object",
  "required": [
    "subject",
    "rwpVersion",
    "claims",
    "assessment",
    "attester",
    "issuedAt",
    "evidence",
    "assessmentResults",
    "supersedes"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "required": [
        "implementationDid",
        "productName",
        "productVersion"
      ],
      "properties": {
        "implementationDid": {
          "type": "string",
          "pattern": "^did:rwp:[^:]+:[^:]+$"
        },
        "productName": {
          "type": "string",
          "minLength": 1
        },
        "productVersion": {
          "type": "string",
          "minLength": 1
        },
        "deployment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "rwpVersion": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["roles"],
        "properties": {
          "profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "producer",
                "custodian",
                "consumer",
                "resolver",
                "source-adapter",
                "attester"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "method",
        "assurance",
        "testSuite",
        "tool",
        "toolVersion",
        "testedAt"
      ],
      "properties": {
        "method": {
          "enum": [
            "self-attested",
            "independently-assessed"
          ]
        },
        "assurance": {
          "enum": [
            "self-attested",
            "independently-assessed",
            "certified"
          ]
        },
        "testSuite": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string"
        },
        "testedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "attester": {
      "type": "string",
      "pattern": "^did:rwp:[^:]+:[^:]+$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "hash"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "assessmentResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "testId",
          "result"
        ],
        "properties": {
          "testId": {
            "type": "string"
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not-tested"
            ]
          },
          "testedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "testedBy": {
            "type": ["string", "null"],
            "pattern": "^did:rwp:[^:]+:[^:]+$"
          },
          "evidence": {
            "type": "string"
          },
          "evidenceHash": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:rwp:[^:]+:[^:]+$"
      }
    }
  },
  "additionalProperties": false
}